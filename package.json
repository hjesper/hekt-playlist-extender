{
  "name": "hekt-playlist-extender",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@10.28.1",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build && pnpm --filter @hekt/source-adapter build",
    "build:sidecar": "pnpm --filter @hekt/source-adapter package:binary",
    "build:tauri": "pnpm build && pnpm build:sidecar",
    "test": "pnpm --filter @hekt/source-adapter test",
    "tauri": "tauri"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.8.0",
    "@tauri-apps/plugin-dialog": "^2.4.0",
    "@tanstack/react-query": "^5.87.1",
    "lucide-react": "^0.544.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.8.4",
    "@types/react": "^19.1.16",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.2",
    "autoprefixer": "^10.4.21",
    "postcss": "^8.5.6",
    "tailwindcss": "^3.4.17",
    "typescript": "~5.8.3",
    "vite": "^7.1.5",
    "vitest": "^3.2.4"
  }
}
