{
  "name": "@hekt/source-adapter",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "pkg": {
    "assets": [
      "node_modules/playwright-core/browsers.json",
      "../node_modules/.pnpm/playwright-core@*/node_modules/playwright-core/browsers.json"
    ]
  },
  "scripts": {
    "build": "tsc",
    "test": "vitest run",
    "spike:coverage": "pnpm build && node dist/coverage-spike.js",
    "package:binary": "pnpm build && pkg --config package.json dist/index.js --target node20-macos-arm64 --output ../src-tauri/binaries/hekt-source-adapter-aarch64-apple-darwin"
  },
  "dependencies": {
    "playwright-core": "1.55.0",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@types/node": "^20.17.0",
    "@yao-pkg/pkg": "^6.22.0",
    "typescript": "~5.8.3",
    "vitest": "^3.2.4"
  }
}
